# Copiar este archivo como .env y completar los valores reales. Nunca commitear el .env real.

DEBUG=False
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria
ALLOWED_HOSTS=127.0.0.1,localhost,tu-dominio.com

# Base de Datos
USE_POSTGRES=True
DB_NAME=vetersystem_db
DB_USER=vetersystem_user
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# Email (recordatorios, recuperación de contraseña, notificaciones del Portal).
# Si se deja vacío, los correos se imprimen por consola (modo desarrollo).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@tu-dominio.com

# Mercado Pago (cobro de Suscripciones). Sin esto, el pago online queda deshabilitado
# y la facturación se maneja manualmente desde el Panel de Suscripciones.
# Se obtienen en https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Resúmenes clínicos con IA (Anthropic). Sin API key o con el flag en False,
# el botón de generar resumen no aparece. Se obtiene en https://console.anthropic.com
IA_RESUMENES_ENABLED=False
ANTHROPIC_API_KEY=

# Recordatorios de turnos por WhatsApp (Twilio). Sin credenciales o con el flag en
# False, el cron no manda nada. Se obtienen en https://console.twilio.com (el Sandbox
# de WhatsApp es gratis para probar: TWILIO_WHATSAPP_FROM=whatsapp:+14155238886).
# TWILIO_CONTENT_SID_RECORDATORIO es el Content Template (obligatorio, Twilio ya no
# acepta texto libre) creado una sola vez en el Content Template Builder.
WHATSAPP_RECORDATORIOS_ENABLED=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID_RECORDATORIO=
